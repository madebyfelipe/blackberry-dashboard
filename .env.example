# Copie para .env.local e preencha. Nada daqui vai para o repositório.

# Obrigatória em produção (mín. 16 caracteres): openssl rand -base64 32
AUTH_SECRET=

# Tempo real — eventos (mensagem nova, presença, aviso de chamada).
# Ably → Dashboard → App → API keys. É a chave-raiz: só no servidor.
ABLY_API_KEY=

# Tempo real — mídia da chamada (áudio + tela compartilhada).
# LiveKit Cloud → Settings → Keys. As três juntas, ou nenhuma.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
